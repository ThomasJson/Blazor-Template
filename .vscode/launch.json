{
  "version": "0.2.0",
  "configurations": [
    {
      "name": ".NET Launch (Blazor Server)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/Template.WebUI/bin/Debug/net8.0/Template.WebUI.dll",
      "args": [],
      "cwd": "${workspaceFolder}/Template.WebUI",
      "console": "externalTerminal",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "sourceFileMap": {
        "/Views": "${workspaceFolder}/Views"
      }
    }
  ]
}
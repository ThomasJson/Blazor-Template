<button @onclick="OnClick" type="@Type"
    class="w-full p-3 border-2 border-black bg-lightPrimary dark:bg-darkPrimary dark:border-lightPrimary text-black dark:text-white rounded-lg font-semibold shadow transition-all duration-150 flex items-center justify-center gap-2 hover:bg-gray-50 dark:hover:bg-gray-800 hover:shadow-lg active:scale-95 @Class"
    disabled="@Disabled">
    @if (!string.IsNullOrEmpty(Icon))
    {
        <i class="@Icon"></i>
    }
    @ChildContent
</button>

@code {
    [Parameter] public string Icon { get; set; }
    [Parameter] public string Type { get; set; } = "button";
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string Class { get; set; }
    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }
    [Parameter] public RenderFragment ChildContent { get; set; }
}